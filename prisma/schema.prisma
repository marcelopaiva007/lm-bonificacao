// =============================================================================
// Schema ATIVO — banco organizado em schemas do Postgres (cutover 24/07/2026)
// =============================================================================
// Reflete o estado do banco após prisma/migrations-manual/01-cutover.sql
// (runbook em docs/MIGRACAO-BANCO.md; o schema antigo está em
// prisma/schema.pre-cutover.bak para consulta).
//
// Decisões:
//  - Um único banco Neon, organizado em schemas: shared, bonificacao, rh.
//    (vapt e contabil pertencem a outros apps — não são modelados aqui.)
//    (vapt_* são movidos para o schema `vapt` pelo SQL, mas pertencem ao app
//     VAPT — não são modelados aqui.)
//  - FKs continuam REAIS (o PostgreSQL suporta foreign key entre schemas).
//    Isso mantém a integridade no banco. O DESACOPLAMENTO do User em relação
//    ao RH é feito removendo apenas as relações User→Empresa/Setor (viram
//    colunas simples empresaId/setorId, sem FK) — esse é o passo que destrava
//    a separação futura de bancos, porque tira a única dependência do schema
//    `shared` para dentro do `rh`.
//  - Ainda restam 3 FKs cross-schema para shared.User (ImportLote, Fechamento,
//    Pesquisa). Elas são mantidas por ora; no dia da separação DEFINITIVA em
//    bancos distintos, viram referência leve (ver docs/MIGRACAO-BANCO.md, Fase B).
//  - IMPORTANTE: com estes apps, NÃO rode `prisma migrate` contra produção.
//    O schema é gerido à mão + `prisma db pull`/`migrate resolve`.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["shared", "bonificacao", "rh"]
}

// ============================================================
// SHARED — autenticação (candidato natural a virar banco próprio)
// ============================================================
// Enums are kept as plain String columns (not Prisma `enum`) so the schema
// works unchanged on both SQLite (local dev) and Postgres (production),
// since SQLite does not support native enums.
// Role: "ADMIN" | "DIRETORIA"
// Cargo: "VENDEDOR_EXTERNO" | "ATENDIMENTO_ADM" | "SUPERVISOR" | "OUTRO_SETOR"
// Origem: "MANUAL" | "IMPORTADO"
// StatusFechamento: "ABERTO" | "FECHADO"

model User {
  id           String   @id @default(cuid())
  nome         String
  username     String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())

  fechamentosFechados FechamentoMensal[] @relation("FechadoPor")
  importLotes         ImportLote[]

  @@schema("shared")
}

// ============================================================
// BONIFICACAO — motor de vendas
// ============================================================
model Cidade {
  id   String @id @default(cuid())
  nome String @unique

  funcionarios Funcionario[]

  @@schema("bonificacao")
}

model Equipe {
  id           String       @id @default(cuid())
  nome         String
  supervisorId String?
  supervisor   Funcionario? @relation("SupervisorDaEquipe", fields: [supervisorId], references: [id])
  tamanhoTier  Int?

  membros Funcionario[] @relation("MembroDaEquipe")

  @@index([supervisorId])
  @@schema("bonificacao")
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  cpf       String?  @unique
  email     String?
  telegramChatId String?
  cargo     String
  cidadeId  String?
  cidade    Cidade?  @relation(fields: [cidadeId], references: [id])
  equipeId  String?
  equipe    Equipe?  @relation("MembroDaEquipe", fields: [equipeId], references: [id])
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  equipesSupervisionadas Equipe[]                @relation("SupervisorDaEquipe")
  lancamentos            LancamentoVenda[]
  bonificacoes           BonificacaoCalculada[]
  ajustes                Ajuste[]

  @@index([cidadeId])
  @@index([equipeId])
  @@schema("bonificacao")
}

model RegraBonificacao {
  id             String    @id @default(cuid())
  cargo          String
  vigenciaInicio DateTime
  vigenciaFim    DateTime?
  config         Json?
  observacoes    String?
  createdAt      DateTime  @default(now())

  @@index([cargo, vigenciaInicio])
  @@schema("bonificacao")
}

model LancamentoVenda {
  id               String       @id @default(cuid())
  funcionarioId    String
  funcionario      Funcionario  @relation(fields: [funcionarioId], references: [id])
  periodo          String
  quantidade       Int          @default(0)
  aprovado         Int          @default(0)
  cancelado        Int          @default(0)
  valorInstalado   Float        @default(0)
  valorDemaisServicos Float     @default(0)
  qtdInternet      Int          @default(0)
  qtdChip          Int          @default(0)
  qtdGps           Int          @default(0)
  qtdTv            Int          @default(0)
  qtdStreaming     Int          @default(0)
  qtdTelefoniaFixa Int          @default(0)
  origem           String       @default("MANUAL")
  importLoteId     String?
  importLote       ImportLote?  @relation(fields: [importLoteId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([funcionarioId, periodo])
  @@index([periodo])
  @@index([importLoteId])
  @@schema("bonificacao")
}

model ImportLote {
  id                String   @id @default(cuid())
  arquivoNome       String
  dataImportacao    DateTime @default(now())
  usuarioId         String
  // FK cross-schema (bonificacao → shared.User). Mantida por ora; vira soft ref na Fase B.
  usuario           User     @relation(fields: [usuarioId], references: [id])
  linhasOk          Int      @default(0)
  linhasErro        Int      @default(0)
  mapeamentoJson    Json?
  detalhesErrosJson Json?

  lancamentos LancamentoVenda[]

  @@index([usuarioId])
  @@schema("bonificacao")
}

model FechamentoMensal {
  id                    String    @id @default(cuid())
  periodo               String    @unique
  status                String    @default("ABERTO")
  valorTotalVendido     Float     @default(0)
  valorTotalBonificacao Float     @default(0)
  fechadoPorId          String?
  // FK cross-schema (bonificacao → shared.User). Mantida por ora; vira soft ref na Fase B.
  fechadoPor            User?     @relation("FechadoPor", fields: [fechadoPorId], references: [id])
  fechadoEm             DateTime?
  createdAt             DateTime  @default(now())

  bonificacoes BonificacaoCalculada[]
  ajustes      Ajuste[]

  @@index([fechadoPorId])
  @@schema("bonificacao")
}

model BonificacaoCalculada {
  id              String           @id @default(cuid())
  fechamentoId    String
  fechamento      FechamentoMensal @relation(fields: [fechamentoId], references: [id])
  funcionarioId   String
  funcionario     Funcionario      @relation(fields: [funcionarioId], references: [id])
  valorInternet   Float            @default(0)
  valorChip       Float            @default(0)
  valorDemais     Float            @default(0)
  valorSupervisor Float            @default(0)
  valorTotal      Float            @default(0)
  detalhesJson    Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([fechamentoId, funcionarioId])
  @@index([funcionarioId])
  @@schema("bonificacao")
}

model Ajuste {
  id            String            @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario       @relation(fields: [funcionarioId], references: [id])
  fechamentoId  String?
  fechamento    FechamentoMensal? @relation(fields: [fechamentoId], references: [id])
  periodo       String
  descricao     String
  valor         Float
  createdAt     DateTime          @default(now())

  @@index([funcionarioId, periodo])
  @@index([fechamentoId])
  @@schema("bonificacao")
}

model ContratoAtivacaoElleven {
  id                       Int      @id @default(autoincrement())
  contrato                 String   @unique
  vendedor1                String?
  vendedor2                String?
  origem                   String?
  dataContrato             String?
  localContrato            String?
  primeiraMensalidade      String?
  valorPrimeiraMensalidade String?
  codigoCliente            String?
  nomeCliente              String?
  enderecoAtivacao         String?
  cep                      String?
  cidade                   String?
  servicoAtivado           String?
  valServAtivado           String?
  assinaturaContrato       String?
  prazoAtivacaoContrato    String?
  ativacaoContrato         String?
  statusContrato           String?
  ativacaoConexao          String?
  syncedAt                 DateTime @default(now()) @updatedAt

  @@map("contrato_ativacao_elleven")
  @@schema("bonificacao")
}

model ElevenRelatorioLinha {
  id        Int      @id @default(autoincrement())
  relatorio String
  periodo   String
  chave     String
  dados     Json
  syncedAt  DateTime @default(now())

  @@unique([relatorio, periodo, chave])
  @@index([relatorio, periodo])
  @@map("elleven_relatorio_linha")
  @@schema("bonificacao")
}

model VendaChipMovel {
  id            Int      @id @default(autoincrement())
  vendaId       Int      @unique
  periodo       String
  sellerIdMovel Int?
  sellerNome    String?
  sellerCpf     String?
  clienteNome   String?
  clienteCpf    String?
  msisdn        String?
  iccid         String?
  planoNome     String?
  planoPreco    String?
  status        String?
  soldAt        String?
  activatedAt   String?
  cancelledAt   String?
  syncedAt      DateTime @default(now())

  @@index([periodo])
  @@map("venda_chip_movel")
  @@schema("bonificacao")
}

// ============================================================
// RH — clima organizacional (candidato natural a virar banco próprio)
// ============================================================
model Empresa {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  setores       Setor[]
  posicoes      Posicao[]
  colaboradores Colaborador[]
  pesquisas     Pesquisa[]

  @@schema("rh")
}

model Setor {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  colaboradores Colaborador[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@schema("rh")
}

model Posicao {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  colaboradores Colaborador[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@schema("rh")
}

model Colaborador {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  nome           String
  cpf            String?
  email          String?
  setorId        String
  setor          Setor    @relation(fields: [setorId], references: [id])
  posicaoId      String
  posicao        Posicao  @relation(fields: [posicaoId], references: [id])
  telegramChatId String?
  salarioFicha   Float?
  dataAdmissao   DateTime?
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tokens SurveyToken[]
  respostas Resposta[]

  @@unique([empresaId, cpf])
  @@unique([telegramChatId])
  @@index([empresaId])
  @@index([setorId])
  @@index([posicaoId])
  @@index([salarioFicha])
  @@index([dataAdmissao])
  @@schema("rh")
}

model Pesquisa {
  id          String    @id @default(cuid())
  empresaId   String
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  titulo      String
  descricao   String?
  anonima     Boolean   @default(true)
  status      String    @default("DRAFT")
  criadoPorId String?
  // FK cross-schema (rh → shared.User). Mantida por ora; vira soft ref na Fase B.
  criadoPor   User?     @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  iniciadaEm  DateTime?
  encerradaEm DateTime?

  perguntas Pergunta[]
  tokens    SurveyToken[]
  respostas Resposta[]

  @@index([empresaId, status])
  @@index([criadoPorId])
  @@schema("rh")
}

model Pergunta {
  id           String   @id @default(cuid())
  pesquisaId   String
  pesquisa     Pesquisa @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  ordem        Int
  enunciado    String
  tipo         String   @default("LIKERT_5")
  dimensaoGPTW String?
  obrigatoria  Boolean  @default(true)

  opcoes  Opcao[]
  itens   RespostaItem[]

  @@unique([pesquisaId, ordem])
  @@index([pesquisaId])
  @@schema("rh")
}

model Opcao {
  id         String   @id @default(cuid())
  perguntaId String
  pergunta   Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  ordem      Int
  texto      String

  itens RespostaItem[]

  @@index([perguntaId])
  @@schema("rh")
}

model SurveyToken {
  id            String    @id @default(cuid())
  pesquisaId    String
  pesquisa      Pesquisa    @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  token         String    @unique
  canal         String    @default("TELEGRAM")
  status        String    @default("PENDING")
  enviadoEm     DateTime?
  respondidoEm  DateTime?
  erro          String?
  createdAt     DateTime  @default(now())

  @@unique([pesquisaId, colaboradorId])
  @@index([status])
  @@index([colaboradorId])
  @@schema("rh")
}

model Resposta {
  id                  String   @id @default(uuid())
  pesquisaId          String
  pesquisa            Pesquisa     @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  colaboradorId       String?
  colaborador         Colaborador? @relation(fields: [colaboradorId], references: [id])
  setorNomeSnapshot   String
  posicaoNomeSnapshot String
  createdAt           DateTime     @default(now())

  itens RespostaItem[]

  @@index([pesquisaId])
  @@index([colaboradorId])
  @@schema("rh")
}

model RespostaItem {
  id            String    @id @default(uuid())
  respostaId    String
  resposta      Resposta  @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  perguntaId    String
  pergunta      Pergunta  @relation(fields: [perguntaId], references: [id])
  valorNumerico Int?
  valorTexto    String?
  opcaoId       String?
  opcao         Opcao?    @relation(fields: [opcaoId], references: [id])

  @@index([respostaId])
  @@index([perguntaId])
  @@index([opcaoId])
  @@schema("rh")
}
