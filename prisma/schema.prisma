// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  nome               String
  username           String   @unique
  email              String?  @unique
  cpf                String?  @unique
  passwordHash       String
  role               String
  ativo              Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  setorId   String?
  setor     Setor?   @relation(fields: [setorId], references: [id], onDelete: SetNull)

  fechamentosFechados FechamentoMensal[]   @relation("FechadoPor")
  importLotes         ImportLote[]
  pesquisasCriadas    Pesquisa[]
  scopes              UserEmpresaScope[]
  resetTokens         PasswordResetToken[]
}

model Cidade {
  id   String @id @default(cuid())
  nome String @unique

  funcionarios Funcionario[]
}

model Equipe {
  id           String       @id @default(cuid())
  nome         String
  supervisorId String?
  supervisor   Funcionario? @relation("SupervisorDaEquipe", fields: [supervisorId], references: [id])
  tamanhoTier  Int?

  membros Funcionario[] @relation("MembroDaEquipe")
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  cpf       String?  @unique
  email     String?
  telegramChatId String?
  cargo     String
  cidadeId  String?
  cidade    Cidade?  @relation(fields: [cidadeId], references: [id])
  equipeId  String?
  equipe    Equipe?  @relation("MembroDaEquipe", fields: [equipeId], references: [id])
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  equipesSupervisionadas Equipe[]                @relation("SupervisorDaEquipe")
  lancamentos            LancamentoVenda[]
  bonificacoes           BonificacaoCalculada[]
  ajustes                Ajuste[]

  @@index([cidadeId])
  @@index([equipeId])
}

model RegraBonificacao {
  id             String    @id @default(cuid())
  cargo          String
  vigenciaInicio DateTime
  vigenciaFim    DateTime?
  config         Json?
  observacoes    String?
  createdAt      DateTime  @default(now())

  @@index([cargo, vigenciaInicio])
}

model LancamentoVenda {
  id               String       @id @default(cuid())
  funcionarioId    String
  funcionario      Funcionario  @relation(fields: [funcionarioId], references: [id])
  periodo          String
  quantidade       Int          @default(0)
  aprovado         Int          @default(0)
  cancelado        Int          @default(0)
  valorInstalado   Float        @default(0)
  valorDemaisServicos Float     @default(0)
  qtdInternet      Int          @default(0)
  qtdChip          Int          @default(0)
  qtdGps           Int          @default(0)
  qtdTv            Int          @default(0)
  qtdStreaming     Int          @default(0)
  qtdTelefoniaFixa Int          @default(0)
  origem           String       @default("MANUAL")
  importLoteId     String?
  importLote       ImportLote?  @relation(fields: [importLoteId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([funcionarioId, periodo])
  @@index([periodo])
}

model ImportLote {
  id                String   @id @default(cuid())
  arquivoNome       String
  dataImportacao    DateTime @default(now())
  usuarioId         String
  usuario           User     @relation(fields: [usuarioId], references: [id])
  linhasOk          Int      @default(0)
  linhasErro        Int      @default(0)
  mapeamentoJson    Json?
  detalhesErrosJson Json?

  lancamentos LancamentoVenda[]
}

model FechamentoMensal {
  id                    String    @id @default(cuid())
  periodo               String    @unique
  status                String    @default("ABERTO")
  valorTotalVendido     Float     @default(0)
  valorTotalBonificacao Float     @default(0)
  fechadoPorId          String?
  fechadoPor            User?     @relation("FechadoPor", fields: [fechadoPorId], references: [id])
  fechadoEm             DateTime?
  createdAt             DateTime  @default(now())

  bonificacoes BonificacaoCalculada[]
  ajustes      Ajuste[]
}

model BonificacaoCalculada {
  id              String           @id @default(cuid())
  fechamentoId    String
  fechamento      FechamentoMensal @relation(fields: [fechamentoId], references: [id])
  funcionarioId   String
  funcionario     Funcionario      @relation(fields: [funcionarioId], references: [id])
  valorInternet   Float            @default(0)
  valorChip       Float            @default(0)
  valorDemais     Float            @default(0)
  valorSupervisor Float            @default(0)
  valorTotal      Float            @default(0)
  detalhesJson    Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([fechamentoId, funcionarioId])
  @@index([funcionarioId])
}

model Ajuste {
  id            String            @id @default(cuid())
  funcionarioId String
  funcionario   Funcionario       @relation(fields: [funcionarioId], references: [id])
  fechamentoId  String?
  fechamento    FechamentoMensal? @relation(fields: [fechamentoId], references: [id])
  periodo       String
  descricao     String
  valor         Float
  createdAt     DateTime          @default(now())

  @@index([funcionarioId, periodo])
}

model ContratoAtivacaoElleven {
  id                       Int      @id @default(autoincrement())
  contrato                 String   @unique
  vendedor1                String?
  vendedor2                String?
  origem                   String?
  dataContrato             String?
  localContrato            String?
  primeiraMensalidade      String?
  valorPrimeiraMensalidade String?
  codigoCliente            String?
  nomeCliente              String?
  enderecoAtivacao         String?
  cep                      String?
  cidade                   String?
  servicoAtivado           String?
  valServAtivado           String?
  assinaturaContrato       String?
  prazoAtivacaoContrato    String?
  ativacaoContrato         String?
  statusContrato           String?
  ativacaoConexao          String?
  syncedAt                 DateTime @default(now()) @updatedAt

  @@map("contrato_ativacao_elleven")
}

model ElevenRelatorioLinha {
  id        Int      @id @default(autoincrement())
  relatorio String
  periodo   String
  chave     String
  dados     Json
  syncedAt  DateTime @default(now())

  @@unique([relatorio, periodo, chave])
  @@index([relatorio, periodo])
  @@map("elleven_relatorio_linha")
}

model Empresa {
  id          String   @id @default(cuid())
  nome        String   @unique
  cnpj        String?  @unique
  razaoSocial String?
  marca       String?
  logoUrl     String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())

  usuarios      User[]
  setores       Setor[]
  posicoes      Posicao[]
  colaboradores Colaborador[]
  pesquisas     Pesquisa[]
  scopes        UserEmpresaScope[]
}

model UserEmpresaScope {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nivelAcesso       String   @default("OPERADOR")
  modulosPermitidos Json?
  createdAt         DateTime @default(now())

  @@unique([userId, empresaId])
  @@index([userId])
  @@index([empresaId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model Setor {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios      User[]
  colaboradores Colaborador[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Posicao {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  colaboradores Colaborador[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Colaborador {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  nome           String
  cpf            String?
  email          String?
  setorId        String
  setor          Setor    @relation(fields: [setorId], references: [id])
  posicaoId      String
  posicao        Posicao  @relation(fields: [posicaoId], references: [id])
  telegramChatId String?
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tokens SurveyToken[]
  respostas Resposta[]

  @@unique([empresaId, cpf])
  @@unique([telegramChatId])
  @@index([empresaId])
  @@index([setorId])
  @@index([posicaoId])
}

model Pesquisa {
  id          String    @id @default(cuid())
  empresaId   String
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  titulo      String
  descricao   String?
  anonima     Boolean   @default(true)
  status      String    @default("DRAFT")
  criadoPorId String?
  criadoPor   User?     @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  iniciadaEm  DateTime?
  encerradaEm DateTime?

  perguntas Pergunta[]
  tokens    SurveyToken[]
  respostas Resposta[]

  @@index([empresaId, status])
}

model Pergunta {
  id           String   @id @default(cuid())
  pesquisaId   String
  pesquisa     Pesquisa @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  ordem        Int
  enunciado    String
  tipo         String   @default("LIKERT_5")
  dimensaoGPTW String?
  obrigatoria  Boolean  @default(true)

  opcoes  Opcao[]
  itens   RespostaItem[]

  @@unique([pesquisaId, ordem])
  @@index([pesquisaId])
}

model Opcao {
  id         String   @id @default(cuid())
  perguntaId String
  pergunta   Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  ordem      Int
  texto      String

  itens RespostaItem[]

  @@index([perguntaId])
}

model SurveyToken {
  id            String    @id @default(cuid())
  pesquisaId    String
  pesquisa      Pesquisa    @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  token         String    @unique
  canal         String    @default("TELEGRAM")
  status        String    @default("PENDING")
  enviadoEm     DateTime?
  respondidoEm  DateTime?
  erro          String?
  createdAt     DateTime  @default(now())

  @@unique([pesquisaId, colaboradorId])
  @@index([status])
}

model Resposta {
  id                  String   @id @default(uuid())
  pesquisaId          String
  pesquisa            Pesquisa     @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  colaboradorId       String?
  colaborador         Colaborador? @relation(fields: [colaboradorId], references: [id])
  setorNomeSnapshot   String
  posicaoNomeSnapshot String
  createdAt           DateTime     @default(now())

  itens RespostaItem[]

  @@index([pesquisaId])
}

model RespostaItem {
  id            String    @id @default(uuid())
  respostaId    String
  resposta      Resposta  @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  perguntaId    String
  pergunta      Pergunta  @relation(fields: [perguntaId], references: [id])
  valorNumerico Int?
  valorTexto    String?
  opcaoId       String?
  opcao         Opcao?    @relation(fields: [opcaoId], references: [id])

  @@index([respostaId])
  @@index([perguntaId])
}

model AuditLog {
  id           String   @id @default(cuid())
  usuarioId    String?
  usuarioNome  String
  usuarioRole  String?
  acao         String
  modulo       String
  detalhes     String
  metadataJson Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([modulo])
  @@index([acao])
  @@index([usuarioNome])
}
